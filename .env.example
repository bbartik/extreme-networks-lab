# Copy this file to .env and fill in your values. Never commit .env.

# Extreme Platform ONE / ExtremeCloud IQ API token.
# CONFIRMED: a static API token (shape extr_sk_v1...) works as a Bearer
# token against this tenant — XIQ UI: Account > API Token to generate one.
P1_API_TOKEN=

# Base URL for the newer "v1" REST API — public docs consistently point
# at one global endpoint, not a per-region one like Mist:
P1_BASE_URL=https://api.extremecloudiq.com

# The v0 "classic XIQ" API host — different from P1_BASE_URL above.
# Confirmed real 2026-08-16 via captured browser traffic: SSID creation
# only exists here (no creation endpoint exists in the newer v1 API at
# all, confirmed by searching its full spec). Same bearer token works
# against both hosts.
P1_V0_BASE_URL=https://cloudapi.extremecloudiq.com/xiq/v0

# The specific admin account's owner id (NOT org_id, which is always 0 in
# this tenant) — required by v0 API calls. No known way to discover this
# via API; watch any v0 request in browser devtools (query param
# ?ownerId=... or the "ownerId" field on any v0 object) to find yours.
P1_OWNER_ID=

# Filled in after running scripts/discover.py once you know it
P1_LOCATION_ID=
